[Unit]
Description=Jarvis offline Raspberry Pi voice assistant
After=sound.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/jarvis
EnvironmentFile=-/home/pi/jarvis/.env
ExecStart=/home/pi/jarvis/.venv/bin/python -m jarvis
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/pi/jarvis/data

[Install]
WantedBy=multi-user.target
